<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <comment>智能问答服务公共配置</comment>
    <entry key="spring.application.name">intelligent-qa-audit-service</entry>
    <entry key="spring.datasource.hikari.maximum-pool-size">${DB_POOL_MAX_SIZE:20}</entry>
    <entry key="spring.datasource.hikari.minimum-idle">${DB_POOL_MIN_IDLE:5}</entry>
    <entry key="spring.datasource.hikari.connection-timeout">${DB_CONNECTION_TIMEOUT_MS:3000}</entry>
    <entry key="spring.datasource.hikari.validation-timeout">${DB_VALIDATION_TIMEOUT_MS:1000}</entry>
    <entry key="spring.datasource.hikari.max-lifetime">${DB_MAX_LIFETIME_MS:1700000}</entry>
    <entry key="spring.redis.timeout">${REDIS_TIMEOUT:2s}</entry>
    <entry key="spring.redis.connect-timeout">${REDIS_CONNECT_TIMEOUT:2s}</entry>
    <entry key="spring.flyway.enabled">true</entry>
    <entry key="spring.flyway.validate-migration-naming">true</entry>
    <entry key="mybatis.mapper-locations">classpath*:/mapper/**/*.xml</entry>
    <entry key="mybatis.configuration.map-underscore-to-camel-case">false</entry>
    <entry key="mybatis.configuration.local-cache-scope">statement</entry>
    <entry key="mybatis.configuration.default-fetch-size">${DB_DEFAULT_FETCH_SIZE:100}</entry>
    <entry key="mybatis.configuration.default-statement-timeout">${DB_STATEMENT_TIMEOUT_SECONDS:5}</entry>
    <entry key="mybatis.configuration.jdbc-type-for-null">NULL</entry>
    <entry key="server.shutdown">graceful</entry>
    <entry key="server.forward-headers-strategy">framework</entry>
    <entry key="server.jetty.connection-idle-timeout">5s</entry>
    <entry key="server.jetty.threads.max">${HTTP_MAX_THREADS:200}</entry>
    <entry key="management.info.env.enabled">true</entry>
    <entry key="management.endpoint.health.probes.enabled">true</entry>
    <entry key="management.observations.key-values.application">${spring.application.name}</entry>
    <entry key="management.observations.key-values.environment">${app.runtime.stage}</entry>
    <entry key="info.app.name">${spring.application.name}</entry>
    <entry key="info.app.environment">${app.runtime.stage}</entry>
    <entry key="info.app.active-profile">${app.runtime.profile}</entry>
    <entry key="app.qa.max-question-characters">${QA_MAX_QUESTION_CHARACTERS:4000}</entry>
    <entry key="app.qa.max-answer-characters">${QA_MAX_ANSWER_CHARACTERS:30000}</entry>
    <entry key="app.qa.max-context-items">${QA_MAX_CONTEXT_ITEMS:8}</entry>
    <entry key="app.qa.max-knowledge-characters">${QA_MAX_KNOWLEDGE_CHARACTERS:40000}</entry>
    <entry key="app.qa.max-business-data-characters">${QA_MAX_BUSINESS_DATA_CHARACTERS:20000}</entry>
    <entry key="app.qa.max-history-messages">${QA_MAX_HISTORY_MESSAGES:20}</entry>
    <entry key="app.qa.min-intent-confidence">${QA_MIN_INTENT_CONFIDENCE:0.85}</entry>
    <entry key="app.qa.event-buffer-size">${QA_EVENT_BUFFER_SIZE:512}</entry>
    <entry key="app.qa.executor-core-size">${QA_EXECUTOR_CORE_SIZE:8}</entry>
    <entry key="app.qa.executor-max-size">${QA_EXECUTOR_MAX_SIZE:32}</entry>
    <entry key="app.qa.executor-queue-capacity">${QA_EXECUTOR_QUEUE_CAPACITY:200}</entry>
    <entry key="app.business-query.enabled">${BUSINESS_QUERY_ENABLED:false}</entry>
    <entry key="app.business-query.maximum-rows">${BUSINESS_QUERY_MAXIMUM_ROWS:100}</entry>
    <entry key="app.business-query.semantic-model-version">${BUSINESS_SEMANTIC_MODEL_VERSION:phase1-v1}</entry>
    <entry key="app.qa.cancellation.scan-delay-millis">${QA_CANCELLATION_SCAN_DELAY_MS:1000}</entry>
    <entry key="app.qa.cancellation.lease-millis">${QA_CANCELLATION_LEASE_MS:130000}</entry>
    <entry key="app.qa.cancellation.retry-delay-millis">${QA_CANCELLATION_RETRY_DELAY_MS:2000}</entry>
    <entry key="app.qa.cancellation.message-id-wait-millis">${QA_CANCELLATION_MESSAGE_ID_WAIT_MS:120000}</entry>
    <entry key="app.qa.cancellation.maximum-attempts">${QA_CANCELLATION_MAX_ATTEMPTS:3}</entry>
    <entry key="app.qa.cancellation.batch-size">${QA_CANCELLATION_BATCH_SIZE:50}</entry>
    <entry key="app.company-model.connect-timeout-millis">${COMPANY_MODEL_CONNECT_TIMEOUT_MS:3000}</entry>
    <entry key="app.company-model.read-timeout-millis">${COMPANY_MODEL_READ_TIMEOUT_MS:120000}</entry>
    <entry key="app.company-model.max-request-characters">${COMPANY_MODEL_MAX_REQUEST_CHARACTERS:100000}</entry>
    <entry key="spring.servlet.multipart.max-file-size">1MB</entry>
    <entry key="spring.servlet.multipart.max-request-size">6MB</entry>
    <entry key="app.file.upload-enabled">false</entry>
    <entry key="app.file.maximum-bytes">${QA_FILE_MAXIMUM_BYTES:1048576}</entry>
    <entry key="app.file.maximum-files-per-conversation">${QA_FILE_MAXIMUM_COUNT:5}</entry>
    <entry key="app.file.local-root">${QA_FILE_LOCAL_ROOT:/tmp/intelligent-qa-files}</entry>
</properties>
