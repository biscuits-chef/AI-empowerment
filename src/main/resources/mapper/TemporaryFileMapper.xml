<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.acme.intelligentqa.adapter.out.persistence.mybatis.TemporaryFileMapper">

    <resultMap id="temporaryFileResult"
            type="com.acme.intelligentqa.adapter.out.persistence.mybatis.TemporaryFilePersistenceRecord">
        <id property="id" column="id"/>
        <result property="publicId" column="public_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="idempotencyKey" column="idempotency_key"/>
        <result property="originalName" column="original_name"/>
        <result property="contentType" column="content_type"/>
        <result property="sizeBytes" column="size_bytes"/>
        <result property="sha256" column="sha256"/>
        <result property="objectKey" column="object_key"/>
        <result property="usageType" column="usage_type"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="selectActive" resultMap="temporaryFileResult">
        SELECT id, public_id, conversation_id, owner_id, idempotency_key, original_name, content_type,
               size_bytes, sha256, object_key, usage_type, status, created_at, updated_at, deleted_at
        FROM qa_file
        WHERE owner_id = #{ownerId}
          AND conversation_id = #{conversationId}
          AND deleted_at IS NULL
        ORDER BY created_at ASC, public_id ASC
        LIMIT #{limit}
    </select>

</mapper>
