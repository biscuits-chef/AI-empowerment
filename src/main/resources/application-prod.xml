<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM "http://java.sun.com/dtd/properties.dtd">
<properties>
    <comment>生产环境配置</comment>
    <entry key="spring.datasource.url">${PROD_DB_URL}</entry>
    <entry key="spring.datasource.username">${PROD_DB_USERNAME}</entry>
    <entry key="spring.datasource.password">${PROD_DB_PASSWORD}</entry>
    <entry key="spring.flyway.target">${PROD_FLYWAY_TARGET}</entry>
    <entry key="spring.redis.host">${PROD_REDIS_HOST}</entry>
    <entry key="spring.redis.port">${PROD_REDIS_PORT:6379}</entry>
    <entry key="spring.redis.password">${PROD_REDIS_PASSWORD}</entry>
    <entry key="management.endpoints.web.exposure.include">health,info,prometheus</entry>
    <entry key="management.endpoint.health.show-details">never</entry>
    <entry key="app.runtime.stage">PRODUCTION</entry>
    <entry key="app.runtime.profile">prod</entry>
    <entry key="logging.file.path">${PROD_LOG_PATH:logs/liea-prod}</entry>
    <entry key="app.auth.mode">corporate</entry>
    <entry key="app.auth.mock-user-id"></entry>
    <entry key="app.qa.demo-mode">false</entry>
    <entry key="app.business-query.enabled">${PROD_BUSINESS_QUERY_ENABLED:false}</entry>
    <entry key="app.company-model.enabled">true</entry>
    <entry key="app.company-model.stream-contract-verified">${PROD_COMPANY_MODEL_STREAM_CONTRACT_VERIFIED:false}</entry>
    <entry key="app.company-model.base-url">${PROD_COMPANY_MODEL_BASE_URL}</entry>
    <entry key="app.redis.enabled">true</entry>
    <entry key="app.obs.enabled">${PROD_OBS_ENABLED:false}</entry>
    <entry key="app.file.storage-mode">${PROD_FILE_STORAGE_MODE:disabled}</entry>
    <entry key="app.file.allow-unprocessed-ready">false</entry>
    <entry key="app.rag.mode">${APP_RAG_MODE:MOCK}</entry>
    <entry key="app.rag.urls">${APP_RAG_URLS:}</entry>
    <entry key="app.rag.username">${APP_RAG_USERNAME:}</entry>
    <entry key="app.rag.password">${APP_RAG_PASSWORD:}</entry>
    <entry key="app.rag.database">${APP_RAG_DATABASE:}</entry>
    <entry key="app.rag.collection">${APP_RAG_COLLECTION:}</entry>
    <entry key="app.rag.sort-method">${APP_RAG_SORT_METHOD:RELEVANCE}</entry>
    <entry key="app.rag.read-columns">${APP_RAG_READ_COLUMNS:}</entry>
    <entry key="app.rag.strong-consistency">${APP_RAG_STRONG_CONSISTENCY:false}</entry>
    <entry key="app.rag.vector-candidates">${APP_RAG_VECTOR_CANDIDATES:100}</entry>
    <entry key="app.rag.query-offset">${APP_RAG_QUERY_OFFSET:0}</entry>
    <entry key="app.rag.query-limit">${APP_RAG_QUERY_LIMIT:100}</entry>
    <entry key="datahub.config.enable">${PROD_DATAHUB_ENABLED:false}</entry>
    <entry key="datahub.config.app-code">${PROD_DATAHUB_APP_CODE:}</entry>
    <entry key="datahub.config.server-name">${PROD_DATAHUB_SERVER_NAME:${spring.application.name}}</entry>
    <entry key="datahub.config.api-key">${PROD_DATAHUB_API_KEY:}</entry>
    <entry key="datahub.config.conf-url">${PROD_DATAHUB_CONF_URL:}</entry>
    <entry key="datahub.config.conf-key">${PROD_DATAHUB_CONF_KEY:}</entry>
    <entry key="datahub.config.health-url">${PROD_DATAHUB_HEALTH_URL:}</entry>
    <entry key="datahub.config.endpoint">${PROD_DATAHUB_OBS_ENDPOINT:}</entry>
    <entry key="datahub.config.access-key">${PROD_DATAHUB_OBS_ACCESS_KEY:}</entry>
    <entry key="datahub.config.secret-key">${PROD_DATAHUB_OBS_SECRET_KEY:}</entry>
    <entry key="datahub.config.bucket-name">${PROD_DATAHUB_OBS_BUCKET_NAME:}</entry>
    <entry key="datahub.config.object-path">${PROD_DATAHUB_OBS_OBJECT_PATH:}</entry>
    <entry key="datahub.config.temp-directory">${PROD_DATAHUB_TEMP_DIRECTORY:/tmp/datahub/file}</entry>
</properties>
